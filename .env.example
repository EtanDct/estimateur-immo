# Modèle du fichier .env à créer sur le serveur, à côté de docker-compose.yml.
# Le vrai fichier .env n'est jamais versionné (il est dans .gitignore) : il contient un secret.

# Clés d'API acceptées par l'API, séparées par des virgules. Vide : l'API est ouverte.
# Générer une clé :  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Pour changer de clé sans interruption : mettre les deux (nouvelle,ancienne), mettre le site à jour,
# puis retirer l'ancienne.
CLES_API=
